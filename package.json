{
  "name": "lupinum-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run build:packages && vp exec nuxt build",
    "build:packages": "vp run @lupinum/content-components#build",
    "check": "vp check && vp run lint:vue-template && vp run typecheck",
    "dev": "TMPDIR=/tmp vp exec nuxt dev",
    "generate": "vp run build:packages && vp exec nuxt generate",
    "lint:vue-template": "eslint --max-warnings=0 \"app/**/*.vue\" \"packages/**/*.vue\"",
    "test": "vp test",
    "typecheck": "vp exec nuxi typecheck",
    "preview": "vp exec nuxt preview",
    "postinstall": "vp run build:packages && vp exec nuxt prepare"
  },
  "dependencies": {
    "@lupinum/content-components": "workspace:*",
    "@lupinum/ginko-content": "0.1.6",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/robots": "^6.0.9",
    "@nuxtjs/sitemap": "^8.0.15",
    "@shikijs/transformers": "^4.2.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.4.6",
    "reka-ui": "^2.9.2",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "^1.1.2",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@vue/language-core": "^3.2.6",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "rolldown": "1.1.0",
    "shadcn-vue": "^2.4.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.60.1",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.9"
  },
  "packageManager": "pnpm@10.32.1"
}
