{
  "name": "@lupinum/ginko-docs",
  "version": "0.2.4",
  "description": "A Nuxt documentation layer powered by Ginko Content.",
  "keywords": [
    "content",
    "documentation",
    "i18n",
    "markdown",
    "nuxt"
  ],
  "homepage": "https://github.com/Mat4m0/lupinum-docs-shadcn#readme",
  "bugs": {
    "url": "https://github.com/Mat4m0/lupinum-docs-shadcn/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mat4m0/lupinum-docs-shadcn.git",
    "directory": "layer"
  },
  "files": [
    "app",
    "i18n",
    "modules",
    "runtime",
    "server",
    "shared",
    "content.js",
    "content.ts",
    "components.ts",
    "icon-bundle.ts",
    "index.d.ts",
    "nuxt.config.ts",
    "tags.ts",
    "!**/*.test.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./content": {
      "types": "./content.ts",
      "import": "./content.js",
      "default": "./content.js"
    },
    "./app-config": "./shared/types/app-config.ts",
    "./components": "./components.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp run --workspace-root build:content-entry"
  },
  "dependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.3",
    "@nuxt/image": "^2.0.0",
    "@nuxt/kit": "^4.4.7",
    "@nuxt/scripts": "^0.13.2",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/mcp-toolkit": "0.17.2",
    "@nuxtjs/robots": "^6.1.2",
    "@nuxtjs/sitemap": "^8.2.2",
    "@resvg/resvg-js": "^2.6.0",
    "@shikijs/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.3.0",
    "nitropack": "^2.13.4",
    "nuxt-og-image": "^6.7.2",
    "reka-ui": "^2.9.2",
    "satori": "^0.19.2",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lupinum/ginko-content": ">=0.3.3 <0.4.0",
    "nuxt": ">=4.4.7 <5",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
