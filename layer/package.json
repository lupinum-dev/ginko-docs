{
  "name": "@lupinum/ginko-docs",
  "version": "0.3.0-rc.4",
  "description": "A Nuxt documentation layer powered by Ginko Content.",
  "keywords": [
    "content",
    "documentation",
    "i18n",
    "markdown",
    "nuxt"
  ],
  "homepage": "https://ginko-docs.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/ginko-docs/issues"
  },
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/ginko-docs.git",
    "directory": "layer"
  },
  "files": [
    "app",
    "i18n",
    "modules",
    "public",
    "runtime",
    "server",
    "shared",
    "content-collections.ts",
    "content.js",
    "content.ts",
    "components.ts",
    "icon-bundle.ts",
    "index.d.ts",
    "nuxt.config.ts",
    "tags.ts",
    "!**/*.test.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./content": {
      "types": "./content.ts",
      "import": "./content.js",
      "default": "./content.js"
    },
    "./app-config": "./shared/types/app-config.ts",
    "./components": "./components.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp run --workspace-root build:content-entry"
  },
  "dependencies": {
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/scripts": "^1.3.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/mcp-toolkit": "0.18.1",
    "@nuxtjs/robots": "^6.1.4",
    "@nuxtjs/sitemap": "^8.3.4",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.3.0",
    "nitropack": "^2.13.4",
    "nuxt-og-image": "^6.7.8",
    "reka-ui": "^2.10.3",
    "satori": "^0.19.3",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@lupinum/ginko-content": ">=0.4.0-rc.1 <0.5.0",
    "nuxt": ">=4.4.7 <5",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
