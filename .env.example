# Canonical URL for release builds and previews.
NUXT_PUBLIC_SITE_URL=https://your-site.example.com

# Analytics provider IDs. Keep providers disabled in app/site.config.ts
# until the project actually uses them.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
NUXT_PUBLIC_GA4_ID=
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_META_PIXEL_ID=
NUXT_PUBLIC_LINKEDIN_INSIGHT_ID=

# Basin endpoints. Development and test use BASIN_TEST_ENDPOINT;
# production uses the per-form endpoint.
BASIN_TEST_ENDPOINT=
BASIN_CONTACT_ENDPOINT=

# Optional chatbot provider ID. The core template keeps chat disabled
# until app/site.config.ts enables a provider recipe.
NUXT_PUBLIC_CHAT_PROVIDER_ID=
